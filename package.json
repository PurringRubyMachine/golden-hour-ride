{
  "name": "golden-hour-ride",
  "private": true,
  "description": "Browser cycling ride over real terrain (Three.js). No build step: these are development tools only.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8791",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1"
  }
}
